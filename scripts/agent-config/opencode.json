{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "@playwright/mcp", "--headless", "--browser", "chromium"]
    },
    "forgejo": {
      "type": "local",
      "enabled": true,
      "command": ["sh", "-c", "exec forgejo-mcp --transport stdio --url \"${FORGEJO_URL:-http://localhost:3000}\""]
    }
  }
}
